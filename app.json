{
  "expo": {
    "name": "Gotabicho",
    "slug": "gotabicho",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "gotabicho",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/zen-old-mincho/400Regular/ZenOldMincho_400Regular.ttf",
            "node_modules/@expo-google-fonts/yuji-syuku/400Regular/YujiSyuku_400Regular.ttf"
          ]
        }
      ],
      "expo-router",
      "expo-sqlite"
    ],
    "ios": {
      "bundleIdentifier": "com.mizutamine.gotabicho",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.mizutamine.gotabicho",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db79fd54-0666-4432-8c4f-ca1c8381db65"
      }
    },
    "owner": "billypun8"
  }
}
